        "city": { "type": "string" },
        "taxNumber": { "type": "string" },
        "taxOffice": { "type": "string" },
        "isDealer": { "type": "boolean" },
        "discountTier": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "roles": {
        "admin": { "read": true, "write": true },
        "owner": { "read": true, "write": true }
      }
    },
    "Product": {
      "collection": "products",
      "fields": {
