{
  "name": "siatek-b2b-platform",
  "private": true,
  "version": "1.0.0",
  "description": "Alpha Teknik Siatek B2B & Saha Operasyon Portalı",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "deploy": "npm run build && firebase deploy --only firestore:rules,hosting",
    "start": "node dist/server.cjs",
    "clean": "rm -rf dist server.js",
    "lint": "echo 'Lint is not configured' && exit 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude 'tests/*.test.cjs' --exclude '.yedek-claude/**'",
    "test:security": "node --test tests/security.test.cjs",
    "test:unit": "npx vitest run src/db/db.unit.test.ts src/utils/",
    "test:simulation": "npx vitest run src/db/db.simulation.test.ts",
    "test:integration": "npx vitest run src/db/db.integration.test.ts",
    "db:migrate": "node -e \"console.log('Versioned SQL migrations located in drizzle/migrations/')\"",
    "db:seed": "tsx src/db/seed.ts",
    "cap:sync": "cap sync",
    "build:android": "npm run build && npx cap sync android",
    "open:android": "npx cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.1",
    "@capacitor/core": "^8.5.1",
    "@capacitor/ios": "^8.5.1",
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/canvas-confetti": "^1.9.0",
    "@types/jsbarcode": "^3.11.4",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-react": "^5.0.4",
    "canvas-confetti": "^1.9.4",
    "d3": "^7.9.0",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.2",
    "express": "^4.21.2",
    "firebase": "^12.18.0",
    "html5-qrcode": "^2.3.8",
    "jsbarcode": "^3.12.3",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "qrcode": "^1.5.4",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.1",
    "@types/d3": "^7.4.3",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vitest": "^3.2.7"
  }
}
