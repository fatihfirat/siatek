# ALPHA Teknik - Canlı Sunucu (Production) Ortam Değişkenleri Şablonu
# Bu dosyayı sunucuda `.env` olarak kopyalayın ve değerleri doldurun.

# 1. Uygulama Modu ve Portu
NODE_ENV=production
PORT=3000

# 2. Kalıcı Veritabanı Bağlantısı (PostgreSQL - ZORUNLU)
# Güvenlik gereği production modunda bu adres olmadan uygulama fail-fast ile durur.
DATABASE_URL="postgresql://kullanici_adi:gizli_sifre@sunucu_adresi:5432/alphateknik_prod"

# 3. İsteğe Bağlı: Şifreleme Anahtarları (Session/JWT Security)
AUTH_SECRET="BURAYA_RASTGELE_UZUN_BIR_ANAHTAR_YAZIN_ALPHA_SECURE_2026"

# 4. İsteğe Bağlı: Gemini AI Anahtarı (Kurumsal Teklif Masası için)
GEMINI_API_KEY="AIzaSy_Sizin_Anahtariniz..."

# 5. İsteğe Bağlı: Geliştirici veya Test Veritabanı
# TEST_DATABASE_URL="postgresql://.../alphateknik_test"
